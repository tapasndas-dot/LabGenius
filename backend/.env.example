# Application metadata
APP_NAME=LabGenius
APP_VERSION=0.28.0

# Supabase project settings (use deployment-specific values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-supabase-key

# PostgreSQL connection string for this environment
DATABASE_URL=postgresql://database-user:database-password@database-host:5432/database-name

# Authentication (generate a unique strong secret for every environment)
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated, explicit browser origins; do not use a wildcard
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Account and password security policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
